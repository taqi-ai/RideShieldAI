/* RideShield AI - Next-Gen Automotive OS Stylesheet */

QMainWindow {
    background-color: #05070A;
}

QWidget {
    font-family: 'Segoe UI', 'Inter', sans-serif;
    color: #FFFFFF;
}

/* Typography */
.h1 {
    font-size: 36px;
    font-weight: 800;
    color: #FFFFFF;
    letter-spacing: 2px;
}

.h2 {
    font-size: 24px;
    font-weight: 700;
    color: #E0E0E0;
    letter-spacing: 1px;
}

.h3 {
    font-size: 18px;
    font-weight: 600;
    color: #A0A0A0;
    letter-spacing: 1px;
    text-transform: uppercase;
}

.info-text {
    font-size: 14px;
    font-weight: 500;
    color: #888888;
}

.value-large {
    font-size: 64px;
    font-weight: 800;
    color: #FFFFFF;
}

.value-medium {
    font-size: 32px;
    font-weight: 700;
    color: #FFFFFF;
}

/* Glassmorphism Cards */
.glass-card {
    background-color: rgba(15, 20, 30, 0.6);
    border: 1px solid rgba(0, 229, 255, 0.15);
    border-radius: 12px;
}

.glass-card:hover {
    border: 1px solid rgba(0, 229, 255, 0.4);
    background-color: rgba(20, 25, 40, 0.7);
}

/* Safety & Alert States */
.safe-text {
    color: #39FF14;
    font-weight: bold;
}

.alert-text {
    color: #FF3333;
    font-weight: bold;
}

.safe-card-active {
    background-color: rgba(57, 255, 20, 0.1);
    border: 2px solid #39FF14;
}

.alert-card-active {
    background-color: rgba(255, 51, 51, 0.15);
    border: 2px solid #FF3333;
}

/* Navigation Bar */
#bottom-nav {
    background-color: qlineargradient(x1:0, y1:0, x2:0, y2:1, stop:0 rgba(10, 10, 15, 0.8), stop:1 #000000);
    border-top: 1px solid rgba(255, 255, 255, 0.05);
}

.nav-button {
    background-color: transparent;
    color: #888888;
    border: none;
    font-size: 16px;
    font-weight: bold;
    text-transform: uppercase;
    letter-spacing: 1px;
}

.nav-button:hover {
    color: #00E5FF;
}

.nav-button:checked {
    color: #00E5FF;
    background-color: rgba(255, 255, 255, 0.05);
    border-bottom: 3px solid #00E5FF;
    border-radius: 8px;
}

.nav-button[alert_mode="true"] {
    color: #FF3333;
}

.nav-button[alert_mode="true"]:checked {
    color: #FFFFFF;
    border-bottom: 3px solid #FF3333;
}

/* Buttons */
.primary-button {
    background-color: #00E5FF;
    color: #000000;
    font-weight: bold;
    padding: 12px 24px;
    border-radius: 6px;
    font-size: 14px;
    text-transform: uppercase;
}

.primary-button:hover {
    background-color: #33EBFF;
}

.danger-button {
    background-color: transparent;
    color: #FF3333;
    border: 2px solid #FF3333;
    font-weight: bold;
    padding: 12px 24px;
    border-radius: 6px;
    font-size: 14px;
    text-transform: uppercase;
}

.danger-button:hover {
    background-color: rgba(255, 51, 51, 0.1);
}

/* Forms */
QSpinBox, QComboBox, QLineEdit {
    background-color: rgba(10, 15, 25, 0.8);
    color: #FFFFFF;
    border: 1px solid rgba(0, 229, 255, 0.3);
    border-radius: 6px;
    padding: 8px;
    font-size: 14px;
}

QSpinBox:focus, QComboBox:focus, QLineEdit:focus {
    border: 1px solid #00E5FF;
    background-color: rgba(15, 20, 35, 1);
}

QComboBox::drop-down {
    border: none;
    width: 30px;
}

QComboBox QAbstractItemView {
    background-color: #0F141E;
    color: #FFFFFF;
    selection-background-color: #00E5FF;
    selection-color: #000000;
    border: 1px solid rgba(0, 229, 255, 0.3);
}

/* Scrollbars */
QScrollBar:vertical {
    background: #05070A;
    width: 8px;
    margin: 0px 0px 0px 0px;
}
QScrollBar::handle:vertical {
    background: #333333;
    border-radius: 4px;
    min-height: 20px;
}
QScrollBar::handle:vertical:hover {
    background: #00E5FF;
}
QScrollBar::add-line:vertical, QScrollBar::sub-line:vertical {
    height: 0px;
}
