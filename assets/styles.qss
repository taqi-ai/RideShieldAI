QMainWindow {
    background-color: #05070A;
    color: #FFFFFF;
}

QWidget {
    color: #FFFFFF;
    font-family: 'Segoe UI', 'Inter', sans-serif;
}

/* Glassmorphism Cards */
QWidget.glass-card, QFrame.glass-card {
    background-color: rgba(10, 15, 25, 0.6);
    border: 1px solid rgba(0, 229, 255, 0.2);
    border-radius: 12px;
}

QWidget.glass-card:hover, QFrame.glass-card:hover {
    background-color: rgba(15, 25, 40, 0.8);
    border: 1px solid rgba(0, 229, 255, 0.5);
}

/* Alert States */
QWidget.alert-card-active, QFrame.alert-card-active {
    background-color: rgba(255, 51, 51, 0.15);
    border: 2px solid #FF3333;
    border-radius: 12px;
}

QWidget.safe-card-active, QFrame.safe-card-active {
    background-color: rgba(57, 255, 20, 0.1);
    border: 2px solid #39FF14;
    border-radius: 12px;
}

/* Typography */
QLabel.h1 {
    font-size: 28px;
    font-weight: bold;
    color: #FFFFFF;
}

QLabel.h2 {
    font-size: 20px;
    font-weight: bold;
    color: #00E5FF;
}

QLabel.h3 {
    font-size: 16px;
    font-weight: bold;
    color: #00E5FF;
}

QLabel.value-large {
    font-size: 72px;
    font-weight: bold;
    color: #FFFFFF;
}

QLabel.value-medium {
    font-size: 32px;
    font-weight: bold;
    color: #FFFFFF;
}

QLabel.info-text {
    font-size: 14px;
    color: #A0A0B0;
}

QLabel.alert-text {
    font-size: 24px;
    font-weight: bold;
    color: #FF3333;
}

QLabel.safe-text {
    font-size: 24px;
    font-weight: bold;
    color: #39FF14;
}

QLabel.gear-text {
    font-size: 80px;
    font-weight: bold;
    color: #FFFFFF;
    background-color: transparent;
    border: 2px solid rgba(255, 255, 255, 0.2);
    border-radius: 10px;
    padding: 10px 30px;
}

/* Bottom Navigation Bar */
#bottom-nav {
    background-color: rgba(5, 7, 10, 0.8);
    border-top: 1px solid rgba(0, 229, 255, 0.3);
}

QPushButton.nav-button {
    background-color: transparent;
    border: none;
    padding: 15px 0px;
    font-size: 16px;
    font-weight: bold;
    color: #A0A0B0;
    border-top: 4px solid transparent;
}

QPushButton.nav-button:hover {
    color: #FFFFFF;
}

QPushButton.nav-button:checked {
    color: #00E5FF;
    border-top: 4px solid #00E5FF;
}

QPushButton.nav-button[alert_mode="true"]:checked {
    color: #FF3333;
    border-top: 4px solid #FF3333;
}

/* Camera Frame */
QFrame#camera-frame {
    border: 2px solid #FF3333;
    border-radius: 15px;
    background-color: #000000;
}
